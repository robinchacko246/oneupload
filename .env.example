# Copy this file to ".env" and fill in the values (see SETUP-ML.md)

# Port the app runs on
PORT=3000

# The public address of this app, with no slash at the end.
# Instagram downloads the video from here, so it must be reachable from the internet.
# Examples: https://my-uploader.onrender.com  or a tunnel URL like https://abcd.trycloudflare.com
PUBLIC_BASE_URL=http://localhost:3000

# Password for the web page (username can be anything)
APP_PASSWORD=change-me

# Random long text used to sign the media links
MEDIA_SECRET=put-any-long-random-text-here

# ---- YouTube (Google Cloud Console -> OAuth client, type "Web application") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add this exact URL under "Authorized redirect URIs": <PUBLIC_BASE_URL>/auth/google/callback

# ---- Facebook + Instagram (developers.facebook.com -> your app) ----
META_APP_ID=
META_APP_SECRET=
# Add this exact URL under "Valid OAuth Redirect URIs": <PUBLIC_BASE_URL>/auth/facebook/callback
META_GRAPH_VERSION=v21.0

# How many hours to keep uploaded video files before deleting them
KEEP_FILES_HOURS=24
